      "reference_sha256": "c53c9e27a33c590f687ff4a8c194beb16fe60a29c0345c77ad219ca3979e077f",
      "basis": "S64 is a control, not a predeclared ceiling. Earlier larger native configurations had higher throughput but failed the old small-reference screen; original baseline repetitions now expose its own variation. Preserve all old failures and test larger capacities prospectively against the same complete baseline rule. Do not select S64 merely because its smaller graph sweep was convenient.",
      "capture_rule": "Preserve every native default decode graph size for each capacity, then add 512/1024 as needed. No new compiler/framework/model or precision change. Defaults verified in installed vLLM source, whose SHA and relevant lines are recorded.",
      "vllm_config_sha256": "ba062ec38d075937b73d953059cf1d0e1b96f1474990bc6d45ed45e20ba6a336",
      "vllm_config_excerpt": [
        "        if (",
        "            self.model_config is not None",
        "            and not self.model_config.enforce_eager",
        "            and self.compilation_config.cudagraph_mode != CUDAGraphMode.NONE",
        "        ):",
        "            # determine the initial max_cudagraph_capture_size",
        "            max_cudagraph_capture_size = (",
        "                self.compilation_config.max_cudagraph_capture_size",
        "            )",
        "            if max_cudagraph_capture_size is None:",
        "                decode_query_len = 1",
        "                if (",
        "                    self.speculative_config",
        "                    and self.speculative_config.num_speculative_tokens",
        "                ):",
        "                    decode_query_len += self.speculative_config.num_speculative_tokens",
        "                max_cudagraph_capture_size = min(",
        "                    self.scheduler_config.max_num_seqs * decode_query_len * 2, 512",
        "                )",
        "            max_num_tokens = self.scheduler_config.max_num_batched_tokens",
        "            max_cudagraph_capture_size = min(max_num_tokens, max_cudagraph_capture_size)",
        "",
        "            assert max_cudagraph_capture_size >= 1, (",
        "                \"Maximum cudagraph size should be greater than or equal to 1 \"",
        "                \"when using cuda graph.\"",
        "            )",
        "",
        "            # determine the cudagraph_capture_sizes",
        "            if self.compilation_config.cudagraph_capture_sizes is not None:",
        "                assert len(self.compilation_config.cudagraph_capture_sizes) > 0, (",
        "                    \"cudagraph_capture_sizes should contain at least one element \"",
        "                    \"when using cuda graph.\"",
        "                )",
        "                # de-duplicate the sizes provided by the config",
        "                dedup_sizes = list(set(self.compilation_config.cudagraph_capture_sizes))",
        "                cudagraph_capture_sizes = [",
        "                    i for i in dedup_sizes if i <= max_num_tokens",
        "                ]",
        "                # sort to make sure the sizes are in ascending order",
        "                cudagraph_capture_sizes.sort()",
        "            else:",
        "                if self.performance_mode == \"interactivity\":",
        "                    # Fine-grained CUDA graphs at small batch sizes",
        "                    # for minimal padding overhead",
        "                    interactivity_max = min(max_cudagraph_capture_size, 32)",
        "                    cudagraph_capture_sizes = list(range(1, interactivity_max + 1))",
        "                else:",
        "                    cudagraph_capture_sizes = [",
        "                        i for i in [1, 2, 4] if i <= max_cudagraph_capture_size",
        "                    ]",
        "                if max_cudagraph_capture_size >= 8:",
        "                    # Step size 8 for small batch sizes, up to 256(not included)",
        "                    cudagraph_capture_sizes += list(",
        "                        range(8, min(max_cudagraph_capture_size + 1, 256), 8)",
        "                    )",
        "                if max_cudagraph_capture_size >= 256:",
        "                    # Step size 16 for larger batch sizes",
        "                    cudagraph_capture_sizes += list(",
        "                        range(256, max_cudagraph_capture_size + 1, 16)",
        "                    )",
        "                # ensure max_num_tokens is captured if within max capture size",
        "                if (",
        "                    max_num_tokens <= max_cudagraph_capture_size",
        "                    and max_num_tokens not in cudagraph_capture_sizes",
        "                ):",
        "                    cudagraph_capture_sizes.append(max_num_tokens)",
        "                # de-duplicate and sort the sizes",
        "                cudagraph_capture_sizes = sorted(set(cudagraph_capture_sizes))",
        "",
        "            if (",
        "                self.parallel_config.tensor_parallel_size > 1",
        "                and self.compilation_config.pass_config.enable_sp",
        "            ):"
      ],
      "timing": "Each candidate gets a fresh engine. Both tuning and validation use 30s real warmup, then 180s continuous load and [60,180) steady statistics. Result cache/NVTX/full trajectory export off. Every failed outcome retained.",
      "comparison": "Same fixed per-task budgets and effective threshold. Explicit capacity comparison to corresponding original C16 reference; S64 repeated measurements provide a lower-capacity control. Single screens cannot qualify a default or final saturation boundary. Any better candidate requires fresh repeats, matched-load controls and final independent acceptance.",
